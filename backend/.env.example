# Server Port Config
PORT=3000

# PostgreSQL Connection parameters (e.g. Supabase connection string)
DATABASE_URL="postgresql://postgres:[password]@db.[project-id].supabase.co:5432/postgres?schema=public"

# Supabase Auth Parameters
SUPABASE_URL="https://[project-id].supabase.co"
SUPABASE_ANON_KEY="[your-supabase-anon-key]"

# JWT Secret config for token signatures
JWT_SECRET="[generate-a-secure-random-key]"
